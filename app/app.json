  {
  "expo": {
    "name": "GP ARIES",
    "slug": "app",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.jaamess.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "CAMERA",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS"
      ],
      "package": "com.jaamess.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "./withVoiceFix.js",
      "./withJetifier.js",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "buildToolsVersion": "35.0.0",
            "kotlinVersion": "2.1.20",
            "extraGradleProps": {
              "android.useAndroidX": "true",
              "android.enableJetifier": "true"
            }
          },
          "ios": {
            "useFrameworks": "static"
          }
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "Necesitamos acceso al micrófono."
        }
      ],
      "expo-router"
    ],
    "extra": {
      "eas": {
        "projectId": "9c4ffa71-9508-4149-97a6-d31a5aa30f88"
      }
    }
  }
}